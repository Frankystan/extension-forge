{
  "manifest_version": 3,
  "name": "ExtensionForge Extension",
  "version": "1.0.0",
  "description": "Extensión construida con Angular + Angular Material (Manifest V3).",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": ["storage", "activeTab"]
}
